<?xml version="1.0" encoding="utf-8"?>
<!-- Light: the bars take the page's background colour (the page's background in phone.html). -->
<resources>
    <style name="Theme.Phone" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <color name="background">#F4F5F7</color>
    <color name="icon_background">#3A78C8</color>
</resources>
